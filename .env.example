# Copy to .env and replace every placeholder before running the application.

# One local MySQL database and one connection string for app, migrations, seed and backups.
# MySQL must be self-hosted on localhost/private network (SRS 6.3, 11.3).
DATABASE_URL="mysql://society_app:CHANGE_ME@127.0.0.1:3306/society_management"

NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT="3000"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_COOKIE_SECRET="CHANGE_ME_GENERATE_48_RANDOM_BYTES"
CSRF_SECRET="CHANGE_ME_GENERATE_48_RANDOM_BYTES"

# Private files live outside the public web root (SRS 18).
PRIVATE_STORAGE_DIR="./private-storage"

# Structured logging: info | debug | warn | error
LOG_LEVEL="info"

# Bootstrap super admin (used by db:seed only; remove/rotate after first login).
SEED_SUPERADMIN_EMAIL="superadmin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_SUPERADMIN_NAME="Platform Super Admin"
