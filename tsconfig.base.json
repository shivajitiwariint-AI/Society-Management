{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@society/shared": ["packages/shared/src/index.ts"],
      "@society/validation": ["packages/validation/src/index.ts"],
      "@society/database": ["packages/database/src/index.ts"],
      "@society/authorization": ["packages/authorization/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.next", "**/generated"]
}
